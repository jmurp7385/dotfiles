export ZSH="$HOME/.oh-my-zsh"

# Prompt theme selector:
# - p10k (default): uses powerlevel10k and ~/.p10k.zsh when present
# - starship: uses Starship prompt initialization
if [[ -z "${DOTFILES_PROMPT_THEME:-}" ]]; then
  export DOTFILES_PROMPT_THEME="p10k"
fi

case "$DOTFILES_PROMPT_THEME" in
  starship)
    ZSH_THEME=""
    ;;
  p10k|*)
    ZSH_THEME="powerlevel10k/powerlevel10k"
    ;;
esac

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Shared/local shell modules managed by chezmoi.
[[ -r "$HOME/.tooling.zsh" ]] && source "$HOME/.tooling.zsh"
[[ -r "$HOME/.work.zsh" ]] && source "$HOME/.work.zsh"

if [[ "$DOTFILES_PROMPT_THEME" == "starship" ]]; then
  if command -v starship >/dev/null 2>&1; then
    _starship_bin="$(command -v starship)"
    {{ if eq .chezmoi.os "windows" }}
    # Git Bash + Windows paths with spaces can break generated init script parsing.
    # Only run starship init when the resolved binary path has no spaces.
    if [[ "$_starship_bin" != *" "* ]]; then
      eval "$("$_starship_bin" init zsh)"
    fi
    {{ else }}
    eval "$("$_starship_bin" init zsh)"
    {{ end }}
    unset _starship_bin
  fi
else
  [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
fi
