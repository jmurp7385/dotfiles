export ZSH="$HOME/.oh-my-zsh"

# Set theme to empty since Starship manages the prompt rendering
ZSH_THEME=""

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

{{ if eq .chezmoi.os "windows" }}
if [[ -d "/c/Apps/bin" ]]; then
  export PATH="/c/Apps/bin:$PATH"
fi
{{ end }}

# --- Initialize Starship Prompt ---
if command -v starship >/dev/null 2>&1; then
  _starship_bin="$(command -v starship)"
  {{ if eq .chezmoi.os "windows" }}
  # Git Bash + Windows paths with spaces can break generated init script parsing.
  # Only run starship init when the resolved binary path has no spaces.
  if [[ "$_starship_bin" != *" "* ]]; then
    eval "$("$_starship_bin" init zsh)"
  fi
  {{ else }}
  eval "$("$_starship_bin" init zsh)"
  {{ end }}
  unset _starship_bin
fi

# --- OS Specific Environment Hooks ---
{{ if eq .chezmoi.os "darwin" }}
# macOS-specific aliases & paths
export PATH="/opt/homebrew/bin:$PATH"
alias ls="ls -G"
{{ else if eq .chezmoi.os "linux" }}
# Fedora/Linux specific aliases & paths
alias ls="ls --color=auto"
{{ else if eq .chezmoi.os "windows" }}
# Windows / Git Bash specific aliases
alias open="explorer.exe"
{{ end }}

# --- NVM & Node Initialization ---
{{ if eq .chezmoi.os "windows" }}
# Windows uses nvm-windows via standard system PATH.
# Enable Corepack shim paths if needed:
export PATH="$APPDATA/npm:$PATH"

{{ else if eq .chezmoi.os "darwin" }}
# macOS (Homebrew NVM path)
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

{{ else if eq .chezmoi.os "linux" }}
# Fedora / Linux (Standard NVM path)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{ end }}
